{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storeshot.art/schemas/cli/v1/captions.json",
  "title": "storeshot set --captions captions.json",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,127}$"
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "file",
          "caption"
        ],
        "additionalProperties": false
      }
    },
    "featureGraphic": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "screen": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "caption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "screen"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "screens"
  ],
  "additionalProperties": false
}
